{
  "name": "pi-kagi",
  "version": "1.0.1",
  "description": "A pi extension for kagi search.",
  "keywords": [
    "pi",
    "pi-package",
    "kagi"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "license": "MIT",
  "author": "themauveavenger",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@tsconfig/node26": "26.0.0",
    "@types/node": "26.1.2",
    "typebox": "1.3.8",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ts-pattern": "5.9.0"
  }
}
