{
  "name": "pi-kagi",
  "version": "2.2.1",
  "description": "A pi extension for kagi search.",
  "keywords": [
    "pi",
    "pi-package",
    "kagi"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "license": "MIT",
  "author": "themauveavenger",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./search-budget": "./src/search-budget.ts"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "arch": "ts-archunit check",
    "arch:baseline": "ts-archunit baseline",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\""
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@earendil-works/pi-tui": "0.82.1",
    "@eslint/js": "^10.0.1",
    "@nielspeter/ts-archunit": "^0.57.0",
    "@tsconfig/node26": "26.0.0",
    "@types/node": "26.1.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typebox": "1.3.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.66.0"
  },
  "dependencies": {
    "ts-pattern": "5.9.0"
  }
}
